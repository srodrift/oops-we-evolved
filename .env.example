# MongoDB Atlas connection string. When set, approved harness versions are stored
# with the official Node driver in the morph.harness_versions collection.
# When unset, versions are written to data/harness-versions.json instead.
MONGODB_URI=

# Raindrop write key, passed to the official raindrop-ai SDK as `writeKey`.
# The TypeScript SDK docs use RAINDROP_API_KEY:
# https://raindrop.ai/docs/sdk/typescript/
# RAINDROP_WRITE_KEY is the name @raindrop-ai/ai-sdk reads. Either one is accepted.
# When both are unset, GLITCH still builds this same event locally and MORPH
# mutates from it. When either key is set, that event is sent with begin,
# trackTool, and selfDiagnose.
RAINDROP_API_KEY=
RAINDROP_WRITE_KEY=

# When set, MORPH asks gpt-4o-mini for the next harness. Invalid model output
# falls back to the deterministic proposer, which is always available.
OPENAI_API_KEY=

# Documented for a later voice pass. Not read by this build.
ELEVENLABS_API_KEY=
